# BetAssured — Apache / Traefik
#
# Blog is served by this app at /blog (not the old external betsassuredblog service).
# Traefik terminates TLS, so do NOT force HTTPS here (avoids redirect loops).

Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization header through to PHP (blog cache clear / APIs)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Apex → www only (keep /blog on this site)
    RewriteCond %{HTTP_HOST} ^betsassured\.com$ [NC]
    RewriteRule ^ https://www.betsassured.com%{REQUEST_URI} [R=301,L]

    # Admin blog cache clear endpoints (pitchpredictionsadmin BlogCachePurger)
    RewriteRule ^api/clear-blog-list-cache/?$ api/clear-blog-list-cache.php [QSA,L]
    RewriteRule ^api/clear-blog-cache/?$ api/clear-blog-cache.php [QSA,L]
    RewriteRule ^api/clear-blog-cache/([a-z0-9][a-z0-9\-]{0,190})/?$ api/clear-blog-cache.php?slug=$1 [QSA,L]

    # Blog list + post → front controller (in-app blog, same idea as pitchpredictionswebsite)
    RewriteRule ^blog/?$ index.php [QSA,L]
    RewriteRule ^blog/([a-z0-9][a-z0-9\-]{0,190})/?$ index.php [QSA,L]

    # Strip trailing slash (except root) — /blog/ → /blog
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Allow clean URLs without .php (only if .php file exists)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [NC,L]

    # Front controller: everything else → index.php
    # Let real /api/*.php files be served directly when they exist.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Custom 404 (app page via public shim)
ErrorDocument 404 /404.php

# Restrict access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|env|config\.php|private)$">
    Require all denied
</FilesMatch>
