# BetAssured — Apache behind Traefik
#
# Blog is served by this app at /blog (not the old external blog service).
# Traefik terminates TLS on :443 and proxies HTTP to Apache :5500.
# Never emit relative [R] redirects — Apache would leak http://host:5500.

Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization header through to PHP (blog cache clear / APIs)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Apex → www (absolute https — never relative)
    RewriteCond %{HTTP_HOST} ^betsassured\.com$ [NC]
    RewriteRule ^ https://www.betsassured.com%{REQUEST_URI} [R=301,L]

    # Admin blog cache clear endpoints (pitchpredictionsadmin BlogCachePurger)
    RewriteRule ^api/clear-blog-list-cache/?$ api/clear-blog-list-cache.php [QSA,L]
    RewriteRule ^api/clear-blog-cache/?$ api/clear-blog-cache.php [QSA,L]
    RewriteRule ^api/clear-blog-cache/([a-z0-9][a-z0-9\-]{0,190})/?$ api/clear-blog-cache.php?slug=$1 [QSA,L]

    # In-app blog: internal rewrite only (no redirect, no :5500 leak)
    RewriteRule ^blog/?$ index.php [QSA,L]
    RewriteRule ^blog/([a-z0-9][a-z0-9\-]{0,190})/?$ index.php [QSA,L]

    # Strip trailing slash with absolute canonical URL
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ https://www.betsassured.com/$1 [R=301,L]

    # Allow clean URLs without .php (only if .php file exists)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [NC,L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

ErrorDocument 404 /404.php

<FilesMatch "\.(htaccess|htpasswd|env|config\.php|private)$">
    Require all denied
</FilesMatch>
