# Enable rewrite engine
RewriteEngine On
RewriteBase /

# -------------------------------
# 1. Canonical redirect to https://www.betsassured.com
# -------------------------------
# If host is not the canonical host, redirect immediately to canonical https URL
#RewriteCond %{HTTP_HOST} !^www\.betsassured\.com$ [NC]
#RewriteRule ^ https://www.betsassured.com%{REQUEST_URI} [R=301,L]

# If request is not HTTPS (and proxy didn't already indicate https), redirect to canonical https host
#RewriteCond %{HTTPS} !=on
#RewriteCond %{HTTP:X-Forwarded-Proto} !https
#RewriteRule ^ https://www.betsassured.com%{REQUEST_URI} [R=301,L]

# -------------------------------
# 2. Custom 404 page
# -------------------------------
ErrorDocument 404 /404.php

# -------------------------------
# 3. Clean URLs without .php
# -------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [NC,L]

# -------------------------------
# 4. Front controller: route other requests to index.php
# -------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# -------------------------------
# 5. Restrict access to sensitive files
# -------------------------------
<FilesMatch "\.(htaccess|htpasswd|env|config\.php|private)$">
    Require all denied
</FilesMatch>